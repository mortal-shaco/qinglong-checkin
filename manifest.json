{
  "schemaVersion": 1,
  "project": "checkin",
  "displayName": "通用签到",
  "repositoryName": "shaco-checkin",
  "repository": "https://github.com/mortal-shaco/shaco-checkin",
  "version": "1.0.1",
  "releaseLicense": "GPL-3.0-only",
  "scripts": [
    {
      "catalogId": "0ba7bb41fd4c339c",
      "displayName": "春风动力签到",
      "path": "scripts/cfmoto_checkin.py",
      "sha256": "a3d8c5ec17f1ebc944486943fcf32aff96a146aebb3c576f0a8cab88d11148a7",
      "stage": "released",
      "license": "MIT",
      "licenseGate": "allowed-permissive",
      "source": {
        "kind": "author-owned",
        "owner": "mortal-shaco",
        "originalPath": "shaco_autowork/cf_sign.py"
      },
      "cron": "17 8 * * *",
      "command": "task scripts/cfmoto_checkin.py",
      "environment": [
        {
          "name": "CFMOTO_COOKIE",
          "required": true,
          "sensitive": true,
          "format": "ticket=<value> 或裸 ticket；多账号每行一个",
          "howToGet": "使用本人测试账号在 CFMOTO App 执行一次相关请求，从本人控制的本地网络调试记录中复制 Cookie 请求头里的 ticket；如 App 阻止调试，不要绕过安全机制。"
        },
        {
          "name": "CFMOTO_ACTIVITY_COUNT",
          "required": false,
          "sensitive": false,
          "default": "3",
          "range": "0-3",
          "howToGet": "无需获取；手工设置互动任务轮数，设为 0 可只签到。"
        },
        {
          "name": "CFMOTO_ACTION_DELAY",
          "required": false,
          "sensitive": false,
          "default": "2",
          "range": "0-30",
          "howToGet": "无需获取；手工设置每个积分动作之间的等待秒数。"
        },
        {
          "name": "CFMOTO_POST_CONTENTS",
          "required": false,
          "sensitive": false,
          "format": "多条内容用换行或 | 分隔",
          "howToGet": "无需获取；仅在随机文案接口不可用时，作为自定义本地兜底文案。"
        },
        {
          "name": "CFMOTO_RANDOM_DELAY_MAX",
          "required": false,
          "sensitive": false,
          "default": "0",
          "range": "0-3600",
          "howToGet": "无需获取；手工设置任务启动前的最大随机等待秒数。"
        },
        {
          "name": "CFMOTO_NOTIFY",
          "required": false,
          "sensitive": false,
          "default": "1",
          "howToGet": "无需获取；设为 0 可关闭 notify.py 通知。"
        },
        {
          "name": "CFMOTO_USER_AGENT",
          "required": false,
          "sensitive": false,
          "howToGet": "通常无需设置；仅默认 User-Agent 失效时，从同一 CFMOTO App 请求头复制。"
        },
        {
          "name": "CFMOTO_DRY_RUN",
          "required": false,
          "sensitive": false,
          "default": "0",
          "howToGet": "无需获取；仅预演时手工设为 1。"
        }
      ],
      "multiAccount": {
        "supported": true,
        "separator": "newline",
        "rule": "CFMOTO_COOKIE 每行一个账号"
      },
      "dependencies": [
        "python>=3.10"
      ],
      "features": [
        "执行每日签到",
        "发帖和评论优先使用接口随机文本，返回出处时拼接作者与作品信息，接口异常时使用本地文案兜底",
        "按配置发布帖子、评论、点赞并完成分享积分任务"
      ],
      "sideEffects": [
        "改变账号的当日签到和积分状态",
        "最多发布三个公开帖子并留下可见内容",
        "最多产生三次公开评论、三次点赞和三次分享任务记录",
        "发帖和评论前访问第三方一言接口获取公开随机文本，不发送春风动力账号凭据"
      ],
      "review": {
        "staticPassed": true,
        "sandboxPassed": true,
        "humanAccepted": true,
        "sideEffectsReviewed": true
      },
      "validation": {
        "status": "passed",
        "evidence": "projects/checkin/validation/0ba7bb41fd4c339c",
        "candidateSha256": "a3d8c5ec17f1ebc944486943fcf32aff96a146aebb3c576f0a8cab88d11148a7"
      }
    },
    {
      "catalogId": "621df252c315f2d1",
      "displayName": "什么值得买签到",
      "path": "scripts/smzdm_checkin.js",
      "sha256": "702c2a3123d3a85700d814fd6343a023f78a556761e743d4e61b9cfe29a3c888",
      "stage": "released",
      "license": "MIT",
      "licenseGate": "allowed-permissive",
      "source": {
        "repository": "ump45nose/smzdm-checkin-ql",
        "branch": "main",
        "commit": "6b9eaced964c348efb46d2c13a45ab5c66caaea8",
        "originalPath": "checkin.js"
      },
      "cron": "31 8 * * *",
      "command": "task scripts/smzdm_checkin.js",
      "environment": [
        {
          "name": "SMZDM_ACCOUNT",
          "required": true,
          "sensitive": true,
          "format": "每行一个账号：sk|完整Cookie；Cookie 必须包含 sess=<value>",
          "howToGet": "使用本人测试账号在什么值得买 App 手动签到，从同一条 user-api.smzdm.com POST /checkin 请求中复制 Payload/Form Data 的 sk 和 Request Headers 的完整 Cookie，按 sk|完整Cookie 拼成一行。多账号每个账号一行；不要绕过证书固定。"
        },
        {
          "name": "QINGLONG_NOTIFY",
          "required": false,
          "sensitive": false,
          "default": "1",
          "howToGet": "无需获取；默认通过青龙通知组件推送脱敏任务总结，设为 0 可关闭。"
        },
        {
          "name": "SMZDM_USER_AGENT_APP",
          "required": false,
          "sensitive": false,
          "howToGet": "通常无需设置；只有默认值失效时才从同一请求的 User-Agent 请求头复制。"
        },
        {
          "name": "SMZDM_DRY_RUN",
          "required": false,
          "sensitive": false,
          "default": "0",
          "howToGet": "无需获取；本地验证器会自动设置，青龙手工预演时可设为 1。"
        }
      ],
      "multiAccount": {
        "supported": true,
        "separator": "newline",
        "rule": "SMZDM_ACCOUNT 每个非空行对应一个账号，行内格式为 sk|完整Cookie；账号之间只使用换行"
      },
      "dependencies": [
        "node>=18 with native fetch"
      ],
      "features": [
        "查询账号签到状态与连续签到奖励",
        "执行每日签到",
        "满足条件时领取额外奖励"
      ],
      "sideEffects": [
        "改变什么值得买账号的当日签到与连续签到状态",
        "满足条件时领取奖励并改变账号奖励状态"
      ],
      "review": {
        "staticPassed": true,
        "sandboxPassed": true,
        "humanAccepted": true,
        "sideEffectsReviewed": true
      },
      "validation": {
        "status": "passed",
        "evidence": "projects/checkin/validation/621df252c315f2d1",
        "candidateSha256": "68f47b1dadd65c90cd2153b1c0544ec791e5a01b4e3626ec25d40d35a01a68fd"
      },
      "packaging": {
        "type": "qinglong-discovery-comments",
        "validatedSha256": "68f47b1dadd65c90cd2153b1c0544ec791e5a01b4e3626ec25d40d35a01a68fd",
        "releaseSha256": "702c2a3123d3a85700d814fd6343a023f78a556761e743d4e61b9cfe29a3c888",
        "statement": "Only non-executable name/cron comments were added during release staging."
      }
    },
    {
      "catalogId": "e608052390d250da",
      "displayName": "百度贴吧签到",
      "path": "scripts/tieba_checkin.py",
      "sha256": "77f26117b1e9ea21bf44839116760fba2da4eaa5d8dfbf7f975124a3fadef2c5",
      "stage": "released",
      "license": "GPL-3.0-only",
      "licenseGate": "allowed-copyleft",
      "source": {
        "repository": "sudojia/AutoTaskScript",
        "branch": "script",
        "commit": "4a55327baed0321bdf95802a75cc8363cae118b0",
        "originalPath": "src/web/sudojia_tieba.js"
      },
      "cron": "23 8 * * *",
      "command": "python3 scripts/tieba_checkin.py",
      "environment": [
        {
          "name": "TIEBA_COOKIE",
          "required": true,
          "sensitive": true,
          "format": "建议填写发往 tieba.baidu.com 的完整 Cookie；也兼容裸 BDUSS；多账号每行一个",
          "howToGet": "本人浏览器登录 tieba.baidu.com，打开开发者工具 → Network，选择发往 tieba.baidu.com 的已登录请求并复制完整 Cookie 请求头。"
        },
        {
          "name": "TIEBA_DELAY_MS",
          "required": false,
          "sensitive": false,
          "default": "1200",
          "range": "500-10000",
          "howToGet": "无需获取；按需填写请求间隔毫秒数，建议保留默认值。"
        },
        {
          "name": "TIEBA_VERBOSE",
          "required": false,
          "sensitive": false,
          "default": "0",
          "howToGet": "无需获取；需要详细脱敏日志时手工设为 1。"
        },
        {
          "name": "TIEBA_DRY_RUN",
          "required": false,
          "sensitive": false,
          "default": "0",
          "howToGet": "无需获取；本地验证器会自动设置，青龙手工预演时可设为 1。"
        }
      ],
      "multiAccount": {
        "supported": true,
        "separator": "newline",
        "rule": "TIEBA_COOKIE 每行一个账号，不使用 & 拼接；旧名称 TIE_BA_COOKIE 暂时兼容"
      },
      "dependencies": [
        "python>=3.10 standard library"
      ],
      "features": [
        "获取账号关注的贴吧列表",
        "为尚未签到的贴吧执行每日签到",
        "汇总每个账号的成功与失败数量"
      ],
      "sideEffects": [
        "向百度贴吧提交签到请求并改变账号在对应贴吧的当日签到状态"
      ],
      "review": {
        "staticPassed": true,
        "sandboxPassed": true,
        "humanAccepted": true,
        "sideEffectsReviewed": true
      },
      "validation": {
        "status": "passed",
        "evidence": "projects/checkin/validation/e608052390d250da",
        "candidateSha256": "b0045026a4ec5fda8016e0bb88964461b35ff2f538410e1d05318de3a369ccb7"
      },
      "packaging": {
        "type": "qinglong-discovery-comments",
        "validatedSha256": "b0045026a4ec5fda8016e0bb88964461b35ff2f538410e1d05318de3a369ccb7",
        "releaseSha256": "77f26117b1e9ea21bf44839116760fba2da4eaa5d8dfbf7f975124a3fadef2c5",
        "statement": "Only non-executable name/cron comments were added during release staging."
      }
    }
  ]
