    {
      "catalogId": "0ba7bb41fd4c339c",
      "displayName": "春风动力签到",
      "path": "scripts/cfmoto_checkin.py",
      "sha256": "a0045ccd02412e0c8f8860e163e3252cf09fbf5019129053bf26f6f3e1eb8ff4",
      "stage": "released",
      "license": "MIT",
      "licenseGate": "allowed-permissive",
      "source": {
        "kind": "author-owned",
        "owner": "mortal-shaco",
        "originalPath": "shaco_autowork/cf_sign.py"
      },
      "cron": "17 8 * * *",
      "command": "task scripts/cfmoto_checkin.py",
      "environment": [
        {
          "name": "CFMOTO_COOKIE",
          "required": true,
          "sensitive": true,
          "format": "ticket=<value> 或裸 ticket；多账号每行一个",
          "howToGet": "使用本人测试账号在 CFMOTO App 执行一次相关请求，从本人控制的本地网络调试记录中复制 Cookie 请求头里的 ticket；如 App 阻止调试，不要绕过安全机制。"
        },
        {
          "name": "CFMOTO_ACTIVITY_COUNT",
          "required": false,
          "sensitive": false,
          "default": "3",
          "range": "0-3",
          "howToGet": "无需获取；手工设置互动任务轮数，设为 0 可只签到。"
        },
        {
          "name": "CFMOTO_ACTION_DELAY",
          "required": false,
          "sensitive": false,
          "default": "2",
          "range": "0-30",
          "howToGet": "无需获取；手工设置每个积分动作之间的等待秒数。"
        },
        {
          "name": "CFMOTO_POST_CONTENTS",
          "required": false,
          "sensitive": false,
          "format": "多条内容用换行或 | 分隔",
          "howToGet": "无需获取；按需自行编写公开发帖和评论文案。"
        },
        {
          "name": "CFMOTO_RANDOM_DELAY_MAX",
          "required": false,
          "sensitive": false,
          "default": "0",
          "range": "0-3600",
          "howToGet": "无需获取；手工设置任务启动前的最大随机等待秒数。"
        },
        {
          "name": "CFMOTO_NOTIFY",
          "required": false,
          "sensitive": false,
          "default": "1",
          "howToGet": "无需获取；设为 0 可关闭 notify.py 通知。"
        },
        {
          "name": "CFMOTO_USER_AGENT",
          "required": false,
          "sensitive": false,
          "howToGet": "通常无需设置；仅默认 User-Agent 失效时，从同一 CFMOTO App 请求头复制。"
        },
        {
          "name": "CFMOTO_DRY_RUN",
          "required": false,
          "sensitive": false,
          "default": "0",
          "howToGet": "无需获取；仅预演时手工设为 1。"
        }
      ],
      "multiAccount": {
        "supported": true,
        "separator": "newline",
        "rule": "CFMOTO_COOKIE 每行一个账号"
      },
      "dependencies": [
        "python>=3.10"
      ],
      "features": [
        "执行每日签到",
        "按配置发布帖子、评论、点赞并完成分享积分任务"
      ],
      "sideEffects": [
        "改变账号的当日签到和积分状态",
        "最多发布三个公开帖子并留下可见内容",
        "最多产生三次公开评论、三次点赞和三次分享任务记录"
      ],
      "review": {
        "staticPassed": true,
        "sandboxPassed": true,
        "humanAccepted": true,
        "sideEffectsReviewed": true
      },
      "validation": {
        "status": "passed",
        "evidence": "projects/checkin/validation/cfmoto",
        "candidateSha256": "4c68cab004ff15f57972d6056959f605037d75ee578bdb03c5b7fd71231af809"
      },
      "packaging": {
        "type": "qinglong-discovery-comments",
        "validatedSha256": "4c68cab004ff15f57972d6056959f605037d75ee578bdb03c5b7fd71231af809",
        "releaseSha256": "a0045ccd02412e0c8f8860e163e3252cf09fbf5019129053bf26f6f3e1eb8ff4",
        "statement": "Only non-executable name/cron comments were added during release staging."
      }
    },
    {
      "catalogId": "621df252c315f2d1",
      "displayName": "什么值得买签到",
      "path": "scripts/smzdm_checkin.js",
      "sha256": "59316df8bbdbacdb2c81ea3add726752053df9df9c03973965fb404ad3293df1",
      "stage": "released",
      "license": "MIT",
      "licenseGate": "allowed-permissive",
      "source": {
        "repository": "ump45nose/smzdm-checkin-ql",
        "branch": "main",
        "commit": "6b9eaced964c348efb46d2c13a45ab5c66caaea8",
        "originalPath": "checkin.js"
      },
      "cron": "31 8 * * *",
      "command": "task scripts/smzdm_checkin.js",
      "environment": [
        {
          "name": "SMZDM_COOKIE",
          "required": true,
          "sensitive": true,
          "format": "完整 Cookie，必须包含 sess=<value>；多账号每行一个",
          "howToGet": "使用本人测试账号在什么值得买 App 手动签到，从本人控制的本地网络调试记录中筛选 user-api.smzdm.com 的 POST /checkin 请求，复制 Request Headers 中的完整 Cookie。不要绕过证书固定。"
        },
        {
          "name": "SMZDM_SK",
          "required": true,
          "sensitive": true,
          "format": "同一 /checkin 请求 Payload 中的 sk 值；多账号每行一个并与 Cookie 按行配对",
          "howToGet": "在与 SMZDM_COOKIE 相同的 POST /checkin 请求中打开 Payload/Form Data，复制 sk 字段；必须来自同一账号和同一当前 App 会话。"
        },
        {
          "name": "SMZDM_USER_AGENT_APP",
          "required": false,
          "sensitive": false,
          "howToGet": "通常无需设置；只有默认值失效时才从同一请求的 User-Agent 请求头复制。"
        },
        {
          "name": "SMZDM_DRY_RUN",
          "required": false,
          "sensitive": false,
          "default": "0",
          "howToGet": "无需获取；本地验证器会自动设置，青龙手工预演时可设为 1。"
        }
      ],
      "multiAccount": {
        "supported": true,
        "separator": "newline",
        "rule": "SMZDM_COOKIE 与 SMZDM_SK 每行一个值，按相同行号配对，行数必须一致"
      },
      "dependencies": [
        "node>=18 with native fetch"
      ],
      "features": [
        "查询账号签到状态与连续签到奖励",
        "执行每日签到",
        "满足条件时领取额外奖励"
      ],
      "sideEffects": [
        "改变什么值得买账号的当日签到与连续签到状态",
        "满足条件时领取奖励并改变账号奖励状态"
      ],
      "review": {
        "staticPassed": true,
        "sandboxPassed": true,
        "humanAccepted": true,
        "sideEffectsReviewed": true
      },
      "validation": {
        "status": "passed",
        "evidence": "projects/checkin/validation/621df252c315f2d1",
        "candidateSha256": "c5a0572aba3df812e42ae47206f4af4cbc667a85ff92088040939fa609149b1d"
      },
      "packaging": {
        "type": "qinglong-discovery-comments",
        "validatedSha256": "c5a0572aba3df812e42ae47206f4af4cbc667a85ff92088040939fa609149b1d",
        "releaseSha256": "59316df8bbdbacdb2c81ea3add726752053df9df9c03973965fb404ad3293df1",
        "statement": "Only non-executable name/cron comments were added during release staging."
      }
    },
    {
      "catalogId": "e608052390d250da",
      "displayName": "百度贴吧签到",
      "path": "scripts/tieba_checkin.py",
      "sha256": "1f8622816e190aaa12b1220930b763fad3e458b4684b8ad5b645d88e0c108ca0",
      "stage": "released",
      "license": "GPL-3.0-only",
      "licenseGate": "allowed-copyleft",
      "source": {
        "repository": "sudojia/AutoTaskScript",
        "branch": "script",
        "commit": "4a55327baed0321bdf95802a75cc8363cae118b0",
        "originalPath": "src/web/sudojia_tieba.js"
      },
      "cron": "23 8 * * *",
      "command": "python3 scripts/tieba_checkin.py",
      "environment": [
        {
          "name": "TIE_BA_COOKIE",
          "required": true,
          "sensitive": true,
          "format": "建议填写发往 tieba.baidu.com 的完整 Cookie；也兼容裸 BDUSS；多账号每行一个",
          "howToGet": "本人浏览器登录 tieba.baidu.com，打开开发者工具 → Network，选择发往 tieba.baidu.com 的已登录请求并复制完整 Cookie 请求头。"
        },
        {
          "name": "TIEBA_DELAY_MS",
          "required": false,
          "sensitive": false,
          "default": "1200",
          "range": "500-10000",
          "howToGet": "无需获取；按需填写请求间隔毫秒数，建议保留默认值。"
        },
        {
          "name": "TIEBA_VERBOSE",
          "required": false,
          "sensitive": false,
          "default": "0",
          "howToGet": "无需获取；需要详细脱敏日志时手工设为 1。"
        },
        {
          "name": "TIEBA_DRY_RUN",
          "required": false,
          "sensitive": false,
          "default": "0",
          "howToGet": "无需获取；本地验证器会自动设置，青龙手工预演时可设为 1。"
        }
      ],
      "multiAccount": {
        "supported": true,
        "separator": "newline",
        "rule": "TIE_BA_COOKIE 每行一个账号，不使用 & 拼接"
      },
      "dependencies": [
        "python>=3.10 standard library"
      ],
      "features": [
        "获取账号关注的贴吧列表",
        "为尚未签到的贴吧执行每日签到",
        "汇总每个账号的成功与失败数量"
      ],
      "sideEffects": [
        "向百度贴吧提交签到请求并改变账号在对应贴吧的当日签到状态"
      ],
      "review": {
        "staticPassed": true,
        "sandboxPassed": true,
        "humanAccepted": true,
        "sideEffectsReviewed": true
      },
      "validation": {
